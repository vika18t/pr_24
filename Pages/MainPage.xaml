<Page x:Class="pr_24.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pr_24.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

		<StackPanel Margin="0,0,0,15">
			<TextBlock Text="Библиотека"
                   FontSize="26" FontWeight="Bold"
                   Foreground="Black"/>
			<TextBlock Text="Каталог книг вашей коллекции"
                   FontSize="14"
                   Foreground="Gray"
                   Margin="0,2,0,0"/>
		</StackPanel>

		<StackPanel Grid.Row="1">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="➕ Добавить книгу" Width="130" Height="30" Margin="0,0,10,0" Background="LightGreen" Click="Add_Click"/>
                <Button Content="✏ Редактировать" Width="130" Height="30" Margin="0,0,10,0" Background="LightYellow" Click="Edit_Click"/>
                <Button Content="🗑 Удалить" Width="100" Height="30" Background= "OrangeRed" Click="Delete_Click"/>
            </StackPanel>

            <DataGrid x:Name="gridBooks" AutoGenerateColumns="False"
                      Height="300" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Название"
                                        Binding="{Binding Title}" Width="*"/>
                    <DataGridTextColumn Header="Автор"
                                        Binding="{Binding Author}" Width="200"/>
                    <DataGridTextColumn Header="Год"
                                        Binding="{Binding Year}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</Page>