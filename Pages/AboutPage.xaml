<Page x:Class="pr_24.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pr_24.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="350" d:DesignWidth="800"
      Title="AboutPage">
	<Grid Margin="20">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<Image Grid.Column="0"
               Source="/Images/book.png"
               Width="120" Height="120"
               VerticalAlignment="Top"/>
		<StackPanel Grid.Column="1"
                    Margin="20,0,0,0"
                    VerticalAlignment="Top">

			<TextBlock Text="О программе" FontSize="26" FontWeight="Bold"
                       Margin="0,0,0,20"/>

			<TextBlock Text="Библиотека" FontSize="22"/>
			<TextBlock Text="Версия 1.0" Margin="0,5"/>
			<TextBlock Text="Учебное приложение для управления коллекцией книг."
                       Margin="0,5" TextWrapping="Wrap"/>
			<TextBlock Text="Разработчики: Токарева Виктория, Сергеева Вероника"
                       Margin="0,15,0,0"/>
			<TextBlock Text="Группа: 246" Margin="0,5"/>
			<TextBlock Text="Год разработки: 2026" Margin="0,5"/>
		</StackPanel>
	</Grid>
</Page>