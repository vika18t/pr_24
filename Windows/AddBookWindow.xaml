<Window x:Class="pr_24.Windows.AddBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr_24.Windows"
        mc:Ignorable="d"
        Title="AddBookWindow" Height="450" Width="800">
    <Window.Resources>
        <ControlTemplate x:Key="ErrorTemplate">
            <StackPanel>
                <Border BorderBrush="Red" BorderThickness="2">
                    <AdornedElementPlaceholder/>
                </Border>
                <TextBlock Foreground="Red" FontSize="12"
                           Text="{Binding [0].ErrorContent}"/>
            </StackPanel>
        </ControlTemplate>

        <Style x:Key="BtnStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="15">

        <TextBlock Text="Название:"/>
        <TextBox x:Name="txtTitle" Margin="0,3,0,10"
                 Validation.ErrorTemplate="{StaticResource ErrorTemplate}"
                 Text="{Binding Title, UpdateSourceTrigger=PropertyChanged,
                                ValidatesOnDataErrors=True}"/>

        <TextBlock Text="Автор:"/>
        <TextBox x:Name="txtAuthor" Margin="0,3,0,10"
                 Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Год:"/>
        <TextBox x:Name="txtYear" Margin="0,3,0,10"
                 Validation.ErrorTemplate="{StaticResource ErrorTemplate}"
                 Text="{Binding Year, UpdateSourceTrigger=PropertyChanged,
                                ValidatesOnDataErrors=True}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button Content="Добавить" Width="110" Style="{StaticResource BtnStyle}"
                    Click="Add_Click"/>
            <Button Content="Отмена" Width="90" Style="{StaticResource BtnStyle}"
                    Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
